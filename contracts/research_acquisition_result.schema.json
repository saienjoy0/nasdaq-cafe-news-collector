{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasdaq-cafe.local/contracts/research_acquisition_result.schema.json",
  "title": "NASDAQ Cafe Research Acquisition Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "episodeDate", "wave", "requestSha256", "status", "results"],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "episodeDate": {"type": "string", "format": "date"},
    "wave": {"type": "integer", "minimum": 1, "maximum": 2},
    "requestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["success", "partial", "unavailable"]},
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "status", "provider", "outputPath", "sha256", "recordCount", "reason"],
        "properties": {
          "requestId": {"type": "string"},
          "status": {"enum": ["success", "unavailable", "not-supported", "invalid-request", "provider-error"]},
          "provider": {"type": "string"},
          "outputPath": {"type": ["string", "null"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "recordCount": {"type": "integer", "minimum": 0},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
