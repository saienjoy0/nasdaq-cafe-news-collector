# FRED
FRED_API_KEY=

# Company fundamentals / official filings
FMP_API_KEY=
# SEC requires a declared contact-style User-Agent, for example:
# your-app-name/1.0 contact@example.com
SEC_USER_AGENT=

# Search
SERPAPI_API_KEY=
TAVILY_API_KEY=

# Raw Archive / full-text network and cost safeguards
# 0 means unlimited direct URL attempts. URLs beyond a positive limit remain in
# manifest.json with fulltext_status=not_attempted_limit.
NASDAQ_CAFE_MAX_FULLTEXT_ATTEMPTS=0
NASDAQ_CAFE_FULLTEXT_WORKERS=6
NASDAQ_CAFE_REQUEST_TIMEOUT_SECONDS=20
NASDAQ_CAFE_MAX_ARTICLE_BYTES=5000000
NASDAQ_CAFE_TAVILY_EXTRACT_BASIC_LIMIT=20
NASDAQ_CAFE_TAVILY_EXTRACT_ADVANCED_LIMIT=5
NASDAQ_CAFE_FULLTEXT_DISALLOWED_DOMAINS=
NASDAQ_CAFE_FMP_NEWS_LIMIT=100
NASDAQ_CAFE_FMP_COMPANY_LIMIT=10
NASDAQ_CAFE_SEC_LOOKBACK_DAYS=7
NASDAQ_CAFE_SEC_MAX_FILINGS_PER_COMPANY=100

# Longbridge
# Longbridge MCP/plugin exports are preferred and normally do not require these.
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
